# Copy this file to .env and fill in your own values.
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_appointments?schema=public"

# NextAuth configuration.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Email notifications (Day 19) — SMTP settings for appointment emails
# (booking confirmation, reschedule, cancellation). Any SMTP provider
# works (Gmail App Password, SendGrid, Mailgun, ...). When these are
# not set, the app still runs and logs what would have been sent.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@example.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Healthcare App <no-reply@example.com>"
